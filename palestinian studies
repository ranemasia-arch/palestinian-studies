:root[data-theme="dark"]{--bg:#121a15;--card:#1a251e;--ink:#e6efe8;--mut:#9fb0a5;--acc:#6cc08a;--accink:#0f1a13;--ok:#7fd9a0;--okbg:#1d3a28;--bad:#ff9a90;--badbg:#431e1b;--line:#2c3b31;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.8 Tahoma,"Segoe UI","Noto Naskh Arabic",Arial,sans-serif;min-height:100vh}
main{max-width:640px;margin:0 auto;padding:20px 16px 40px}
h1{font-size:1.5rem;margin:8px 0 4px}
p.sub{color:var(--mut);margin:0 0 20px}
button{font:inherit;color:inherit;cursor:pointer}
button:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
.mode{display:block;width:100%;text-align:right;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px 16px;margin-bottom:10px}
.mode b{display:block}.mode span{color:var(--mut);font-size:.9rem}
.mode:hover{border-color:var(--acc)}
.bar{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin:6px 0 4px}
.bar i{display:block;height:100%;background:var(--acc);transition:width .25s}
.meta{display:flex;justify-content:space-between;color:var(--mut);font-size:.9rem}
.q{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:20px 18px;margin:16px 0;font-size:1.15rem;line-height:1.9}
.opt{display:block;width:100%;text-align:right;background:var(--card);border:1.5px solid var(--line);border-radius:10px;padding:12px 14px;margin-bottom:8px}
.opt:hover:not(:disabled){border-color:var(--acc)}
.opt.ok{background:var(--okbg);border-color:var(--ok);color:var(--ok);font-weight:700}
.opt.no{background:var(--badbg);border-color:var(--bad);color:var(--bad)}
.tf{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.tf .opt{text-align:center;font-size:1.2rem;margin:0}
.note{border-radius:10px;padding:10px 14px;margin:12px 0;background:var(--badbg);color:var(--bad)}
.note.g{background:var(--okbg);color:var(--ok)}
.go,.alt{border-radius:10px;padding:12px 20px;border:1.5px solid var(--acc);margin:6px 6px 0 0}
.go{background:var(--acc);color:var(--accink);font-weight:700}
.alt{background:transparent;color:var(--acc)}
.score{font-size:3rem;font-weight:700;color:var(--acc);margin:8px 0 0;line-height:1.2}
.rev{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin:10px 0}
.rev small{display:block;color:var(--ok);margin-top:4px}
@media (prefers-reduced-motion:reduce){.bar i{transition:none}}
</style>
</head>
