const $=id=>document.getElementById(id);
const app=$("app");
const sh=a=>{a=a.slice();for(let k=a.length-1;k>0;k--){const j=Math.random()*(k+1)|0;[a[k],a[j]]=[a[j],a[k]]}return a};
const mkMC=r=>({t:"mc",q:r[0],o:sh([[r[1],1],[r[2],0],[r[3],0],[r[4],0]]),r:r[1],n:r[5]});
const mkTF=r=>({t:"tf",q:r[0],a:!!r[1],n:r[2],r:(r[1]?"صح":"غلط")+(r[2]?" — "+r[2]:"")});
let Q=[],i=0,sc=0,bad=[],done=false;

function home(){
  app.innerHTML=`<h1>اختبار الدراسات الفلسطينية</h1>
  <p class="sub">من السلايدات 1 إلى 52. الأسئلة والخيارات تُرتَّب عشوائياً في كل مرة.</p>
  <button class="mode" data-k="mc"><b>اختيار من متعدد</b><span>${MC.length} سؤالاً</span></button>
  <button class="mode" data-k="tf"><b>صح أو غلط</b><span>${TF.length} عبارة، مع تصحيح الخطأ</span></button>
  <button class="mode" data-k="all"><b>مختلط</b><span>${MC.length+TF.length} سؤالاً</span></button>`;
  app.querySelectorAll(".mode").forEach(b=>b.onclick=()=>{
    const k=b.dataset.k;
    start(k=="mc"?MC.map(mkMC):k=="tf"?TF.map(mkTF):MC.map(mkMC).concat(TF.map(mkTF)));
  });
}
function start(items){Q=sh(items);i=0;sc=0;bad=[];show()}
function show(){
  const x=Q[i];done=false;
  const body=x.t=="mc"
    ?x.o.map((o,k)=>`<button class="opt" data-k="${k}">${o[0]}</button>`).join("")
    :`<div class="tf"><button class="opt" data-k="1">صح</button><button class="opt" data-k="0">غلط</button></div>`;
  app.innerHTML=`<div class="meta"><span>السؤال ${i+1} من ${Q.length}</span><span>الصحيح: ${sc}</span></div>
  <div class="bar"><i style="width:${i/Q.length*100}%"></i></div>
  <div class="q">${x.t=="tf"?"صح أم غلط؟<br>":""}${x.q}</div>
  <div id="opts">${body}</div><div id="fb"></div>`;
  app.querySelectorAll(".opt").forEach(b=>b.onclick=()=>pick(+b.dataset.k));
}
function pick(k){
  if(done)return;done=true;
  const x=Q[i],bs=[...app.querySelectorAll(".opt")];
  let right;
  if(x.t=="mc"){
    right=!!x.o[k][1];
    bs.forEach((b,n)=>{b.disabled=true;if(x.o[n][1])b.classList.add("ok")});
    if(!right)bs[k].classList.add("no");
  }else{
    right=(k==1)==x.a;
    bs.forEach(b=>{b.disabled=true;if((+b.dataset.k==1)==x.a)b.classList.add("ok")});
    if(!right)bs[bs.findIndex(b=>+b.dataset.k==k)].classList.add("no");
  }
  if(right)sc++;else bad.push(x);
  let msg=right?"إجابة صحيحة":"إجابة خاطئة";
  if(x.t=="tf"&&x.n)msg+=right?"":`. الصحيح: ${x.n}`;
  if(x.t=="mc"&&x.n)msg+=`. ${x.n}`;
  const last=i==Q.length-1;
  $("fb").innerHTML=`<div class="note ${right?"g":""}">${msg}</div><button class="go" id="nx">${last?"عرض النتيجة":"السؤال التالي"}</button>`;
  $("nx").focus();
  $("nx").onclick=()=>{i++;i<Q.length?show():end()};
}
function end(){
  const p=Math.round(sc/Q.length*100);
  app.innerHTML=`<div class="bar"><i style="width:100%"></i></div>
  <div class="score">${p}%</div>
  <p>أجبت عن ${sc} من ${Q.length} إجابة صحيحة.</p>
  <button class="go" id="again">اختبار جديد</button>
  ${bad.length?`<button class="alt" id="retry">أعد الأسئلة الخاطئة (${bad.length})</button>`:""}
  ${bad.length?"<h2>الأسئلة التي أخطأت فيها</h2>"+bad.map(x=>`<div class="rev">${x.q}<small>الإجابة: ${x.t=="mc"?x.r:x.r}</small></div>`).join(""):""}`;
  $("again").onclick=home;
  if(bad.length)$("retry").onclick=()=>start(bad.slice());
}
